#!/bin/sh
set -eu
. "$HOME/.config/yadm/lib/common.sh"
skip_system neovim

# apt's neovim lags behind upstream; install the latest release binary instead.
VERSION="$(curl -fsSL https://api.github.com/repos/neovim/neovim/releases/latest | grep '"tag_name"' | sed -E 's/.*"v([^"]+)".*/\1/')"

if command -v nvim >/dev/null 2>&1 && [ "$(nvim --version | head -1 | sed -E 's/^NVIM v//')" = "$VERSION" ]; then
  echo "[neovim] v$VERSION already installed, skipping"
  exit 0
fi

ASSET="nvim-linux-$(arch)"
echo "[neovim] installing v$VERSION ($ASSET)"
TMP="$(mktemp -d)"
curl -fsSL -o "$TMP/nvim.tar.gz" "https://github.com/neovim/neovim/releases/download/v${VERSION}/${ASSET}.tar.gz"
tar xzf "$TMP/nvim.tar.gz" -C "$TMP"
$SUDO rm -rf /opt/nvim
$SUDO mv "$TMP/$ASSET" /opt/nvim
$SUDO ln -sf /opt/nvim/bin/nvim /usr/local/bin/nvim
rm -rf "$TMP"
