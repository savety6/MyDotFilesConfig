#!/bin/sh
set -eu
. "$HOME/.config/yadm/lib/common.sh"
skip_system docker

# Docker Engine (docker-ce) from Docker's official apt repo -- NOT Ubuntu's
# docker.io, which conflicts with it. If any docker is already installed,
# leave it alone: swapping engines under running containers breaks them.
if command -v docker >/dev/null 2>&1; then
  echo "[docker] $(docker --version) already installed, not touching it"
  exit 0
fi

. /etc/os-release
echo "[docker] installing docker-ce from download.docker.com ($ID $VERSION_CODENAME)"
$SUDO install -m 0755 -d /etc/apt/keyrings
$SUDO curl -fsSL "https://download.docker.com/linux/$ID/gpg" -o /etc/apt/keyrings/docker.asc
$SUDO chmod a+r /etc/apt/keyrings/docker.asc
printf 'Types: deb\nURIs: https://download.docker.com/linux/%s\nSuites: %s\nComponents: stable\nSigned-By: /etc/apt/keyrings/docker.asc\n' \
  "$ID" "$VERSION_CODENAME" | $SUDO tee /etc/apt/sources.list.d/docker.sources >/dev/null
$SUDO apt-get update
$SUDO apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

if [ "$(id -u)" -ne 0 ]; then
  $SUDO usermod -aG docker "$(id -un)"
  echo "[docker] added $(id -un) to the docker group (log out and back in)"
fi
