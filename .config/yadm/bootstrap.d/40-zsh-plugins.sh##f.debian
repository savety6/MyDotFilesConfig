#!/bin/sh
set -eu

# Oh My Zsh, Powerlevel10k, and the zsh plugins ~/.zshrc expects. None of
# these are apt packages (zsh-autosuggestions is, but omz needs it as a
# custom plugin dir, not the system path), so they're cloned directly.
ZSH_CUSTOM="$HOME/.oh-my-zsh/custom"

clone_if_missing() {
  dest="$1"
  repo="$2"
  if [ -d "$dest" ]; then
    echo "[zsh-plugins] $(basename "$dest") already present, skipping"
  else
    echo "[zsh-plugins] cloning $(basename "$dest")"
    git clone --depth=1 "$repo" "$dest"
  fi
}

# Oh My Zsh is just its git repo -- clone it directly instead of piping the
# install script to sh (that script would also try to replace ~/.zshrc and
# change the login shell; both are handled elsewhere).
clone_if_missing "$HOME/.oh-my-zsh" https://github.com/ohmyzsh/ohmyzsh.git

clone_if_missing "$HOME/.powerlevel10k" https://github.com/romkatv/powerlevel10k.git
mkdir -p "$ZSH_CUSTOM/themes"
ln -sf "$HOME/.powerlevel10k" "$ZSH_CUSTOM/themes/powerlevel10k"

clone_if_missing "$ZSH_CUSTOM/plugins/zsh-autosuggestions" https://github.com/zsh-users/zsh-autosuggestions
# Only one syntax highlighter: fast-syntax-highlighting is a full fork/replacement of
# zsh-syntax-highlighting. Running both means they fight over the same ZLE widgets.
clone_if_missing "$ZSH_CUSTOM/plugins/fast-syntax-highlighting" https://github.com/zdharma-continuum/fast-syntax-highlighting
# zsh-autocomplete intentionally left out: it takes over the Tab key for its own
# live completion menu, which fights with zsh-autosuggestions' ghost-text-on-Tab
# accept behavior (garbled inserts / stray "command not found"). ~/.zshrc instead
# binds Tab directly to accept-suggestion-or-complete.
