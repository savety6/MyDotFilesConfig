#!/bin/sh
set -eu
. "$HOME/.config/yadm/lib/common.sh"
skip_system lazygit

# Not packaged for Ubuntu 24.04. Building from a git clone needs a newer Go
# than apt ships, so use the official release binary (checksum-verified).
VERSION="$(curl -fsSL https://api.github.com/repos/jesseduffield/lazygit/releases/latest | grep '"tag_name"' | sed -E 's/.*"v([^"]+)".*/\1/')"

if command -v lazygit >/dev/null 2>&1 && lazygit --version | grep -q "version=$VERSION,"; then
  echo "[lazygit] v$VERSION already installed, skipping"
  exit 0
fi

ASSET="lazygit_${VERSION}_linux_$(arch).tar.gz"
BASE="https://github.com/jesseduffield/lazygit/releases/download/v${VERSION}"
echo "[lazygit] installing v$VERSION ($ASSET)"
TMP="$(mktemp -d)"
curl -fsSL -o "$TMP/$ASSET" "$BASE/$ASSET"
curl -fsSL -o "$TMP/checksums.txt" "$BASE/checksums.txt"
(cd "$TMP" && grep " $ASSET\$" checksums.txt | sha256sum -c -)
tar xzf "$TMP/$ASSET" -C "$TMP" lazygit
$SUDO install -m 0755 "$TMP/lazygit" /usr/local/bin/lazygit
rm -rf "$TMP"
